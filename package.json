{
  "name": "hex-compiler",
  "version": "1.0.0",
  "description": "Magic is fading. You're a Hex Compiler—translating magical hexes into hexadecimal code. An idle game about compiling spells into data and building digital preservation chambers.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "npx http-server . -p 3000 -o",
    "start": "npx http-server . -p 3000 -o",
    "build": "node build.js",
    "build:prod": "node build.js --production",
    "preview": "npx http-server dist -p 3000 -o",
    "package": "bash package-for-friend.sh || ./package-for-friend.sh",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test:e2e": "playwright test",
    "test:operator": "playwright test e2e/operator-sentry.spec.js",
    "test:visual": "playwright test e2e/visual-a11y.spec.js",
    "optimize:images": "node optimize-backgrounds.js",
    "lint": "eslint .",
    "lint:color-debt": "node scripts/lint-color-debt.js",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"js/**/*.js\" \"*.{html,css,md}\"",
    "docs": "jsdoc js -d docs -c jsdoc.json",
    "size-check": "node -e \"const s=require('fs').statSync('dist/js/game.bundle.js'); const kb=s.size/1024; console.log('Bundle: '+kb.toFixed(2)+'KB'); if(kb>2500){console.error('FAIL: exceeds 2.5MB budget'); process.exit(1);} else {console.log('PASS: within 2.5MB budget');}\"",
    "ci": "npm run lint && npm run lint:color-debt && npm run typecheck && npm run test"
  },
  "keywords": [
    "idle",
    "game",
    "incremental"
  ],
  "engines": {
    "node": "^18.14.0 || ^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "axe-core": "^4.12.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "fake-indexeddb": "^6.2.5",
    "http-server": "^14.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdoc": "^4.0.5",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "terser": "^5.48.0",
    "typescript": "^6.0.3"
  }
}
