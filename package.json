{
  "name": "cyber-witches-idle-coven",
  "version": "1.0.0",
  "description": "An idle game about casting spells and building workstations",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "npx http-server . -p 3000 -o",
    "start": "npx http-server . -p 3000 -o",
    "build": "node build.js",
    "build:prod": "node build.js --production",
    "preview": "npx http-server dist -p 3000 -o",
    "package": "bash package-for-friend.sh || ./package-for-friend.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "optimize:images": "node optimize-backgrounds.js",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"*.{html,css,md}\"",
    "docs": "jsdoc js -d docs -c jsdoc.json",
    "ci": "npm run lint && npm run test"
  },
  "keywords": [
    "idle",
    "game",
    "incremental"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "sharp": "^0.34.4",
    "terser": "^5.44.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jsdoc": "^4.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testEnvironmentOptions": {
      "customExportConditions": [
        ""
      ]
    }
  }
}
