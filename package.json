{
  "name": "hex-compiler",
  "version": "1.0.0",
  "description": "Magic is fading. You're a Hex Compiler—translating magical hexes into hexadecimal code. An idle game about compiling spells into data and building digital preservation chambers.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "npx http-server . -p 3000 -o",
    "start": "npx http-server . -p 3000 -o",
    "build": "node build.js",
    "build:prod": "node build.js --production",
    "preview": "npx http-server dist -p 3000 -o",
    "package": "bash package-for-friend.sh || ./package-for-friend.sh",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "optimize:images": "node optimize-backgrounds.js",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"*.{html,css,md}\"",
    "docs": "jsdoc js -d docs -c jsdoc.json",
    "ci": "npm run lint && npm run test"
  },
  "keywords": [
    "idle",
    "game",
    "incremental"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.26.0",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "sharp": "^0.34.5",
    "terser": "^5.44.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "jsdoc": "^4.0.5"
  }
}
