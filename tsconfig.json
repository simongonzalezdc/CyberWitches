{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["js/**/*.js", "types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "docs",
    "tests",
    "build.js",
    "scripts",
    "js/tests",
    "**/*.test.js"
  ]
}
